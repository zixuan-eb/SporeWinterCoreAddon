{
  "multipart": [
    { "when": {"formed": "false", "axis": "y"}, "apply": { "model": "wintercore:block/winter_core_pillar" } },
    { "when": {"formed": "false", "axis": "z"}, "apply": { "model": "wintercore:block/winter_core_pillar_horizontal", "x": 90 } },
    { "when": {"formed": "false", "axis": "x"}, "apply": { "model": "wintercore:block/winter_core_pillar_horizontal", "x": 90, "y": 90 } },
    { "when": {"formed": "true", "is_top": "false", "corner": "0"}, "apply": { "model": "wintercore:block/winter_core_pillar_formed" } },
    { "when": {"formed": "true", "is_top": "false", "corner": "1"}, "apply": { "model": "wintercore:block/winter_core_pillar_formed", "y": 90 } },
    { "when": {"formed": "true", "is_top": "false", "corner": "2"}, "apply": { "model": "wintercore:block/winter_core_pillar_formed", "y": 180 } },
    { "when": {"formed": "true", "is_top": "false", "corner": "3"}, "apply": { "model": "wintercore:block/winter_core_pillar_formed", "y": 270 } },
    { "when": {"formed": "true", "is_top": "true"}, "apply": { "model": "wintercore:block/winter_core_empty" } }
  ]
}
